{{> head}}
<body class="min-h-screen bg-[#0a0f1e]" style="background-image: radial-gradient(circle at 20% 10%, rgba(16, 185, 129, 0.08), transparent 40%), radial-gradient(circle at 80% 90%, rgba(6, 95, 70, 0.06), transparent 40%);">

  <style>
    /* Background decorations */
    .bg-decoration {
      animation: float 6s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-20px); }
    }

    /* Form animations */
    .form-container {
      animation: slideUp 0.6s ease-out;
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Input enhancements */
    input[type="email"] {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    input[type="email"]:hover {
      border-color: rgba(16, 185, 129, 0.4);
      background: rgba(10, 20, 30, 0.95);
      transform: translateY(-1px);
    }

    /* Button enhancement */
    button[type="submit"] {
      position: relative;
      overflow: hidden;
    }

    button[type="submit"]::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), transparent);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    button[type="submit"]:hover::before {
      opacity: 1;
    }

    button[type="submit"]:active {
      transform: translateY(0) !important;
    }

    /* Icon animation */
    .icon-container {
      animation: iconPulse 2s ease-in-out infinite;
    }

    @keyframes iconPulse {
      0%, 100% {
        box-shadow: 0 0 20px rgba(16, 185, 129, 0.3);
      }
      50% {
        box-shadow: 0 0 35px rgba(16, 185, 129, 0.5);
      }
    }
  </style>

  <!-- Background decorations -->
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 overflow-hidden">
    <div class="bg-decoration absolute -top-40 left-1/2 h-[500px] w-[700px] -translate-x-1/2 rounded-full bg-emerald-900/15 blur-[140px]"></div>
    <div class="bg-decoration absolute bottom-0 right-0 h-80 w-80 rounded-full bg-cyan-900/10 blur-[100px]" style="animation-delay: 1s;"></div>
  </div>

  <div class="relative flex min-h-screen items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

      <div class="form-container rounded-[32px] border-2 border-emerald-400/30 bg-[rgba(26,31,46,0.90)] p-10 shadow-[0_8px_32px_rgba(0,0,0,0.4),0_0_40px_rgba(16,185,129,0.2)] backdrop-blur-2xl">

        <!-- Icon -->
        <div class="mb-8 flex justify-center">
          <div class="icon-container flex h-24 w-24 items-center justify-center rounded-3xl border-2 border-emerald-400/40 bg-gradient-to-br from-emerald-500/20 to-cyan-500/10 shadow-[0_0_30px_rgba(16,185,129,0.2)]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
            </svg>
          </div>
        </div>

        <!-- Title -->
        <div class="mb-8 text-center">
          <h1 class="text-3xl font-extrabold tracking-tight text-white mb-3">Reset Your Password</h1>
          <p class="text-[15px] text-slate-300 leading-relaxed">Enter your email address and we'll send you a secure 6-digit verification code to reset your password</p>
        </div>

        <!-- Flash messages -->
        {{#if error_msg}}
          <div class="mb-6 rounded-xl border-l-4 border-red-400 bg-gradient-to-r from-red-500/15 to-red-500/5 px-5 py-4 text-sm text-red-200 shadow-lg backdrop-blur-sm flex items-start gap-3">
            <i class="fas fa-exclamation-circle text-red-400 text-lg mt-0.5"></i>
            <span>{{error_msg}}</span>
          </div>
        {{/if}}
        {{#if success_msg}}
          <div class="mb-6 rounded-xl border-l-4 border-emerald-400 bg-gradient-to-r from-emerald-500/15 to-emerald-500/5 px-5 py-4 text-sm text-emerald-200 shadow-lg backdrop-blur-sm flex items-start gap-3">
            <i class="fas fa-check-circle text-emerald-400 text-lg mt-0.5"></i>
            <span>{{success_msg}}</span>
          </div>
        {{/if}}

        <form method="POST" action="/forgot-password" autocomplete="off" class="space-y-6">
          <label class="block text-sm font-bold text-slate-100">
            <span class="flex items-center gap-2 mb-3">
              <i class="fas fa-envelope text-emerald-400 text-lg"></i>
              Email Address
            </span>
            <input
              type="email"
              name="email"
              placeholder="Enter your registered email"
              required
              autocomplete="email"
              class="mt-1 w-full rounded-xl border-2 border-emerald-400/25 bg-[rgba(3,10,16,0.85)] px-5 py-4 text-white placeholder-slate-500 shadow-inner transition-all focus:border-emerald-400 focus:bg-[rgba(6,15,20,0.9)] focus:outline-none focus:ring-2 focus:ring-emerald-400/20"
            />
            <p class="mt-2.5 text-xs text-slate-400 ml-1">We'll send a verification code to this email</p>
          </label>

          <button type="submit"
            class="w-full rounded-xl bg-gradient-to-r from-emerald-500 to-emerald-600 px-6 py-4 text-base font-bold text-white shadow-[0_10px_25px_rgba(16,185,129,0.35)] transition-all duration-300 hover:-translate-y-1 hover:from-emerald-600 hover:to-emerald-700 hover:shadow-[0_15px_35px_rgba(16,185,129,0.45)] flex items-center justify-center gap-2">
            <i class="fas fa-paper-plane"></i>
            <span>Send Verification Code</span>
          </button>
        </form>

        <!-- Footer Links -->
        <div class="mt-8 space-y-4 border-t border-slate-700/50 pt-6">
          <div class="text-center text-sm">
            <a href="/login" class="font-bold text-emerald-400 hover:text-emerald-300 transition-colors inline-flex items-center justify-center gap-2">
              <i class="fas fa-arrow-left text-xs"></i>
              Back to Login
            </a>
          </div>
          
          <!-- Security Info -->
          <div class="rounded-xl bg-slate-800/30 border border-slate-700/50 p-4">
            <div class="flex items-start gap-3 text-xs text-slate-400">
              <i class="fas fa-info-circle text-emerald-400 mt-0.5"></i>
              <p class="leading-relaxed">
                For security reasons, the verification code will expire after <strong class="text-slate-300">10 minutes</strong>. If you don't receive the email, check your spam folder.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

{{> footer}}
